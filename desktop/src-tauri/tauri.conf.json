{
  "productName": "HoloKudos",
  "version": "1.0.0",
  "identifier": "org.holokudos.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "HoloKudos",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      {
        "src": "../../holokudos-happ/bin/holochain",
        "targets": ["linux", "darwin"]
      },
      {
        "src": "../../holokudos-happ/bin/holochain.exe",
        "targets": ["windows"]
      },
      {
        "src": "../../holokudos-happ/bin/lair-keystore",
        "targets": ["linux", "darwin"]
      },
      {
        "src": "../../holokudos-happ/bin/lair-keystore.exe",
        "targets": ["windows"]
      }
    ]
  }
}
